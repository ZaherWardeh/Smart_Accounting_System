# systemd unit for running the app directly with a venv (no Docker).
# See DEPLOYMENT.md "Ubuntu server, scenario 1: plain venv + systemd".
#
# Install:
#   sudo cp deploy/smart-accounting.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smart-accounting
#
# Adjust User/Group and the two paths below to match where you actually
# put the repo and which system user should own/run it (never root).

[Unit]
Description=Smart Accounting System (Rima) - FastAPI app
After=network.target

[Service]
Type=simple
User=smart-accounting
Group=smart-accounting
WorkingDirectory=/opt/smart-accounting
EnvironmentFile=/opt/smart-accounting/.env
ExecStart=/opt/smart-accounting/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Light sandboxing - the service can't see or touch the rest of the
# filesystem beyond its own directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smart-accounting

[Install]
WantedBy=multi-user.target
