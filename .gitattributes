# Shell scripts run inside Linux containers - a CRLF line ending breaks
# the shebang/interpreter on checkout from a Windows machine with
# core.autocrlf=true. Force LF regardless of the checking-out platform.
*.sh text eol=lf

# Same concern for files meant to be parsed on a Linux server: systemd is
# inconsistent about tolerating a trailing \r in unit files, and it's not
# worth relying on nginx's parser being forgiving about it either.
deploy/*.service text eol=lf
deploy/nginx.conf text eol=lf
