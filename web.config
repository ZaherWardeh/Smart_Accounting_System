<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + HttpPlatformHandler config: lets IIS launch and manage the FastAPI
  app as a child process instead of needing Docker or a separate service
  manager. See DEPLOYMENT.md "IIS (Windows Server, no Docker)" section.

  Before use: change processPath below to the venv's python.exe on YOUR
  server. API_KEY is deliberately NOT set here - set it as a machine-level
  environment variable on the server instead (see the guide), so this
  file stays safe to commit with no secret in it.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\inetpub\smart-accounting\.venv\Scripts\python.exe"
                   arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                   startupTimeLimit="60"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile=".\logs\stdout.log">
    </httpPlatform>
  </system.webServer>
</configuration>
